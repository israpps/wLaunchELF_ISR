lang(381, Exploit_MagicGate_failed_psx, "MagicGate Test failed on mc%d:.\nError %d\nInstall OSDMenu MBR on xfrom:/BIEXEC-SYSTEM/xosdmain.elf\nand optionally OSDMenu (recommended)\nhttps://github.com/pcm720/OSDMenu")
