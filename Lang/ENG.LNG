lang(383, Exploit_Info_Line_1, "LoadBOOTer memory card exploit")
lang(384, Exploit_Info_Line_2, "works for ROMVER 1.00-2.20")
lang(385, Exploit_Info_Line_3, "Exception: DTL-H10000(S) (use ProtoPwn), DTL-H3000X, DTL-T1XXXX")
lang(386, Exploit_Info_Line_4, "This exploit simply boots mc?:/BOOT/BOOT.ELF")
lang(387, Exploit_Info_Line_5, "so that you are free to change without signing")
lang(388, Exploit_Info_Line_6, "another exploit, thanks to pcm720.")
lang(389, Exploit_Info_Line_7, "Recommended to use as BOOT.ELF:")
lang(390, Exploit_Info_Line_8, "- Playstation 2 Basic Bootloader Extended (PS2BBLE)")
lang(391, Exploit_Info_Line_9, "- OSDMenu")
lang(392, Exploit_Info_Line_10, "- any program that initializes PS2/PSX on startup.")
